---
# The web app manifest: the name, icons and colors a phone uses when the site
# is added to its home screen, which then opens it full screen like an app.
# Linked from _includes/head.html; icons from `npm run icons`.
#
# No start_url on purpose: it defaults to the page being added, so adding a
# countdown (say, a wedding) gives an icon that opens that countdown.
sitemap: false
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": "standalone",
  "background_color": "#f5f6fb",
  "theme_color": "#6366f1",
  "icons": [
    { "src": {{ '/assets/images/icon-192.png' | relative_url | jsonify }}, "sizes": "192x192", "type": "image/png" },
    { "src": {{ '/assets/images/icon-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png" },
    { "src": {{ '/assets/images/icon-maskable-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
