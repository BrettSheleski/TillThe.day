{
  "name": "time-until",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && esbuild \"src/pages/*.ts\" --bundle --splitting --chunk-names=chunks/[name]-[hash] --format=esm --target=es2022 --minify --sourcemap --outdir=assets/js",
    "watch": "esbuild \"src/pages/*.ts\" --bundle --splitting --chunk-names=chunks/[name]-[hash] --format=esm --target=es2022 --sourcemap --outdir=assets/js --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "fonts": "node scripts/self-host-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/mountains-of-christmas": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/quicksand": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "ical.js": "2.1.0",
    "js-yaml": "4.1.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4"
  }
}
